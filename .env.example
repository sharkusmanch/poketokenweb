# Copy to .env and adjust. Every value here is optional.

# Your local timezone. Usage is bucketed by LOCAL date, so setting this
# correctly is what makes "today" mean today.
TZ=America/Los_Angeles

# Notification targets, comma-separated. Any Apprise URI works; see
# https://github.com/caronc/apprise/wiki for the full list.
#   APPRISE_URLS=discord://webhook_id/webhook_token
#   APPRISE_URLS=ntfy://ntfy.sh/my-topic
#   APPRISE_URLS=pover://user@token
#   APPRISE_URLS=apprise://apprise.example.com:8000/my-key
# Leave empty to disable notifications entirely.
APPRISE_URLS=

# Who owns your Claude/Codex log files. The image defaults to 1000:1000, which
# is the first user on most Linux systems. Run `id -u` and `id -g` to check.
PUID=1000
PGID=1000

# Where your .claude/, .claude.json and .codex/ live, if not your $HOME.
# CLAUDE_HOME=/home/you

# Extra transcript directories to scan, ':'-separated. Each is scanned
# recursively, so either a projects/ dir or the .claude/ above it works.
# Useful for counting sessions from another machine.
#
# These are paths INSIDE the container -- uncomment the matching read-only
# volume in docker-compose.yml, and use the path from the RIGHT of its colon.
# A directory that does not exist is ignored, with one line in the log saying so.
# Point these at the transcript directory itself, not $HOME or / -- the whole
# tree is walked on every refresh, and overlapping roots walk it twice (totals
# stay correct either way; the same turn is only counted once).
# POKETOKENWEB_CLAUDE_PROJECT_ROOTS=/config/extra/other-machine

# Extra Codex rollout directories, same format. A separate list from the Claude
# one on purpose: the two parsers must never be handed the same folder.
# POKETOKENWEB_CODEX_SESSION_ROOTS=/config/extra/codex-sessions

# Highest species the companion pool draws from. Default 649 (Gen I-V), where
# the animated sprite set ends. Set 1025 for all nine generations -- species
# past 649 use static art, and the rarity curve shifts because the later
# generations are legendary-dense.
# POKETOKENWEB_MAX_SPECIES_ID=1025

# Where species data and sprites come from. Defaults are the public PokeAPI and
# the PokeAPI/sprites CDN; set these to run against your own instance
# (https://github.com/PokeAPI/pokeapi), e.g. for offline operation.
# Changing the REST base drops the cached species documents, because each one
# embeds an absolute evolution-chain URL pointing at whoever served it.
# POKETOKENWEB_POKEAPI_BASE_URL=http://pokeapi.local/api/v2
# POKETOKENWEB_POKEAPI_GRAPHQL_URL=http://pokeapi.local/v1beta2
# POKETOKENWEB_SPRITE_BASE_URL=http://sprites.local/sprites
